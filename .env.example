# Copy this file to .env (git-ignored) and set your real key.
# Never paste the key into a chat or store it in shared documents.
OPENAI_API_KEY=sk-...

# Default model (can be overridden per call with the `model` parameter).
# Options: gpt-image-2 | gpt-image-2.5-flare | gpt-image-2.5-sunburst | gpt-image-1.5 | gpt-image-1-mini | gpt-image-1
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional (defaults in parentheses)
# OPENAI_ORG_ID=org-...
# OUTPUT_DIR=./output            (where images are saved)
# LOG_FILE=./logs/uso.jsonl      (per-call usage and estimated cost log)
# FONTS_DIR=./fonts              (.ttf/.otf files for overlay_text)
